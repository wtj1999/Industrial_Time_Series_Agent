# Copy these settings into bi_app/.env (environment variables take priority).
BI_NG_DB_HOST=10.52.94.75
BI_NG_DB_PORT=19030
BI_NG_DB_USER=gdmo
BI_NG_DB_PASSWORD=replace-with-local-password
BI_NG_DB_CONNECT_TIMEOUT=5
BI_NG_DB_READ_TIMEOUT=60

# OpenAI-compatible model: parses parameters, matches values and analyzes results; never generates SQL.
BI_NG_LLM_MODEL=DeepSeek-V4-Flash
BI_NG_LLM_BASE_URL=http://10.2.131.184:3304/v1
BI_NG_LLM_API_KEY=EMPTY
BI_NG_LLM_TIMEOUT=60
# Result analysis uses the same model, capped at 45 seconds without automatic retries.
# Internal model endpoints bypass the host's HTTP proxy by default.
BI_NG_LLM_TRUST_ENV=false
BI_NG_MAX_DATE_DAYS=366
BI_NG_CONFIRMATION_TTL_SECONDS=86400
# Real values scanned per mentioned field; incomplete scans require manual confirmation.
BI_NG_MATCH_SCAN_LIMIT=5000
# Fuzzy-ranked real candidates supplied to the model per mentioned condition.
BI_NG_MATCH_CANDIDATE_LIMIT=60
# BI_NG_CHECKPOINT_PATH=/app/bi_app/.state/ng_checkpoints.sqlite3
# Account validation: normally leave unset to detect local vs Docker runtime.
# In Docker Compose the account service is http://backend:8000, not loopback.
# AUTH_SERVICE_URL=http://backend:8000

