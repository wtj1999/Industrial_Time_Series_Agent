# Copy these values into agent_app/.env; do not commit real credentials.
# QQ example: smtp.qq.com:465 / ssl. Use the mailbox SMTP authorization code.
# Tencent enterprise mail: smtp.exmail.qq.com:465 / ssl; use the full mailbox
# address as the username and its client-specific password. Client service
# access must be enabled for that mailbox.
# For port 587 use SMTP_SECURITY=starttls. TLS is required.
# Outlook.com: smtp-mail.outlook.com:587 / starttls requires OAuth2/Modern Auth.
# The current SMTP transport uses password login and does not implement OAuth2;
# setting an Outlook account password alone does not make it a working sender.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=your-mailbox@example.com
SMTP_PASSWORD=replace-with-smtp-authorization-code
SMTP_FROM_EMAIL=your-mailbox@example.com
SMTP_FROM_NAME=工业时序智能体

# Optional: defaults to agent_app/auth/auth.sqlite3; persist/backup this file.
# AUTH_DB_PATH=/absolute/persistent/path/auth.sqlite3
